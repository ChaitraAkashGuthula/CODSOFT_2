generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  KITCHEN_STAFF
  ADMIN
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEOUT
  DELIVERY
}

enum TableStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum ReservationStatus {
  CONFIRMED
  SEATED
  CANCELLED
  COMPLETED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      UserRole @default(CUSTOMER)
  phone     String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Table {
  id           String        @id @default(cuid())
  tableNumber  Int           @unique
  capacity     Int
  location     String        @default("Main Dining") // e.g. "Main Dining", "Window Bay", "Patio Garden", "VIP Booth"
  status       TableStatus   @default(AVAILABLE)
  qrCodeUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  orders       Order[]
  reservations Reservation[]
}

model Reservation {
  id              String            @id @default(cuid())
  tableId         String
  table           Table             @relation(fields: [tableId], references: [id], onDelete: Cascade)
  customerName    String
  customerEmail   String
  customerPhone   String
  guestCount      Int
  reservationDate String            // YYYY-MM-DD
  timeSlot        String            // e.g. "18:00", "19:30"
  status          ReservationStatus @default(CONFIRMED)
  specialRequests String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([reservationDate, timeSlot])
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  sortOrder   Int        @default(0)
  items       MenuItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model MenuItem {
  id              String      @id @default(cuid())
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name            String
  description     String
  price           Float
  imageUrl        String
  isVegetarian    Boolean     @default(false)
  isVegan         Boolean     @default(false)
  isGlutenFree    Boolean     @default(false)
  isAvailable     Boolean     @default(true)
  preparationTime Int         @default(15) // estimated minutes
  calories        Int?
  allergens       String[]    @default([])
  orderItems      OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([categoryId])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique // e.g. "ORD-1001"
  type            OrderType     @default(DINE_IN)
  status          OrderStatus   @default(PENDING)
  tableId         String?
  table           Table?        @relation(fields: [tableId], references: [id], onDelete: SetNull)
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName    String
  customerPhone   String?
  customerEmail   String?
  notes           String?
  subtotal        Float
  tax             Float
  tip             Float         @default(0)
  total           Float
  paymentStatus   PaymentStatus @default(PAID)
  paymentMethod   String        @default("CARD") // "CARD", "CASH", "UPI", "APPLE_PAY"
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id                 String   @id @default(cuid())
  orderId            String
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId         String
  menuItem           MenuItem @relation(fields: [menuItemId], references: [id])
  quantity           Int      @default(1)
  unitPrice          Float
  customInstructions String?
  createdAt          DateTime @default(now())

  @@index([orderId])
  @@index([menuItemId])
}
